# Ambiente de dev no Docker Desktop (Windows).
# Copie para .env.dev.windows.local (esse nome é ignorado pelo git) e ajuste.
#   copy .env.dev.windows.example .env.dev.windows.local
# Todos os valores abaixo já são os defaults do docker-compose.dev.windows.yml —
# o arquivo só é necessário se você quiser mudar algo.

# --- Postgres (container local, imagem postgres:16-alpine) ---
POSTGRES_USER=prosports
POSTGRES_PASSWORD=prosports
POSTGRES_DB=newprosports
# 5432 do host é do r2p-postgres; use 5433 para acessar de fora (DBeaver/psql).
POSTGRES_HOST_PORT=5433

# --- Portas publicadas no host (3000/8080/8081 estão ocupadas no Windows) ---
BACKEND_HOST_PORT=3100
FRONTEND_HOST_PORT=8090
SITE_HOST_PORT=8091

# --- Segredos (dev apenas — precisam ser diferentes entre si) ---
JWT_SECRET=dev-jwt-secret-troque-em-producao-0001
JWT_REFRESH_SECRET=dev-refresh-secret-troque-em-producao-02
JWT_KEY_SECRET=dev-key-secret-troque-em-producao-000003

# --- Boletins ---
# `local` grava em /app/uploads/boletins (volume uploads_data) e serve pela rota
# /uploads do backend — não depende da VM de SFTP. Produção continua em `gcs`.
STORAGE_PROVIDER=local
# Vazio = URL relativa /uploads/boletins/... (o admin resolve na mesma origem).
PUBLIC_BOLETINS_BASE_URL=
# Para voltar ao SFTP da VM: STORAGE_PROVIDER=sftp + SFTP_HOST/SFTP_USER/
# SFTP_BASE_DIR/PUBLIC_BOLETINS_BASE_URL + bind mount da chave (veja o runbook).

# --- Build ---
# Aparece na sidebar como o commit da build.
GIT_COMMIT=dev
