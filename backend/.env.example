# Autenticação (obrigatório). Use segredos aleatórios distintos, >= 32 chars em produção.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Opcional: segredo dedicado para o token da chave mobile (separa do JWT_SECRET). Se vazio, usa JWT_SECRET.
JWT_KEY_SECRET=
# Origens permitidas (CORS) — allowlist separada por vírgula
CORS_ORIGINS=http://localhost:8080
# Seed do admin (obrigatório em produção)
ADMIN_SEED_PASSWORD=

# Site público — modo produção (commit via GitHub + dispatch)
# GITHUB_PAT=
# GITHUB_REPO=wmarrane/prosports
# GITHUB_SNAPSHOT_BRANCH=develop
# Site público — modo LOCAL (grava snapshot em disco e roda o build localmente; ignora GitHub)
# SITE_SNAPSHOT_LOCAL_DIR=../frontend/public-site-snapshots
