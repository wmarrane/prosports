# Site público estático (institucional + páginas de evento).
# Builda o SSG (npm run build:site -> dist-site) e serve via nginx.
# Em dev sem snapshots, gera só as páginas institucionais (Eventos vazio).
FROM node:24-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
# O package-lock.json é gerado no Windows; `npm ci` omite o binário opcional
# linux-musl do lightningcss (bug de optional deps), quebrando o Tailwind v4.
# Instala o binário casando a versão do lightningcss já instalado.
RUN npm ci && \
    npm install --no-save "lightningcss-linux-x64-musl@$(node -p "require('lightningcss/package.json').version")"
COPY frontend/ ./
RUN npm run build:site

# Estágio 2: nginx serve o estático
FROM nginx:alpine
COPY --from=builder /app/dist-site /usr/share/nginx/html
COPY frontend/nginx-site.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
