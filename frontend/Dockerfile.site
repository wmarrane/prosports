# Site público de DESENVOLVIMENTO: build dinâmico.
# Reconstrói o estático quando o backend grava novos snapshots no volume
# compartilhado `site_snapshots` (publicação em dev) e serve o resultado.
# Em produção o site público é o Firebase — este container NÃO é usado em prod.
FROM node:24-alpine
WORKDIR /app
RUN apk add --no-cache inotify-tools
COPY frontend/package*.json ./
# O package-lock.json é gerado no Windows; `npm ci` omite o binário opcional
# linux-musl do lightningcss (Tailwind v4). Instala o binário + o `serve`.
RUN npm ci && \
    npm install --no-save "lightningcss-linux-x64-musl@$(node -p "require('lightningcss/package.json').version")" serve
COPY frontend/ ./
# Snapshots commitados ficam guardados para semear o volume na 1ª execução
# (o volume montado em public-site-snapshots oculta os do build).
RUN cp -r public-site-snapshots /seed-snapshots && \
    sed -i 's/\r$//' site-publico-entrypoint.sh && \
    chmod +x site-publico-entrypoint.sh
EXPOSE 80
CMD ["./site-publico-entrypoint.sh"]
